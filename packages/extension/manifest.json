{
  "manifest_version": 3,
  "name": "Browser MCP Integrator",
  "version": "0.0.1",
  "permissions": ["tabs", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Not attached",
    "default_icon": {
      "16": "icons/not-attached-16.png",
      "32": "icons/not-attached-32.png"
    }
  }
}
